{
  "name": "beelzebub",
  "version": "2.0.0-dev",
  "description": "One Hell of a Task Master!",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./github": {
      "import": {
        "types": "./dist/github.d.ts",
        "default": "./dist/github.js"
      },
      "require": {
        "types": "./dist/github.d.cts",
        "default": "./dist/github.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "github": [
        "dist/github.d.cts"
      ],
      "testing": [
        "dist/testing.d.cts"
      ]
    }
  },
  "bin": {
    "bz": "./dist/bin/beelzebub.js",
    "beelzebub": "./dist/bin/beelzebub.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://beelzebub.io",
  "keywords": [
    "node.js",
    "typescript",
    "javascript",
    "beelzebub",
    "beelzebub.io",
    "taskmaster",
    "task",
    "tasks",
    "tasker",
    "builder",
    "gulp",
    "streams"
  ],
  "author": {
    "name": "Joseph E. Sutton",
    "email": "joe@jstty.com",
    "url": "http://www.jstty.com"
  },
  "maintainers": [
    {
      "name": "jstty",
      "email": "joe@jstty.com"
    }
  ],
  "bugs": {
    "url": "https://github.com/jstty/beelzebub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jstty/beelzebub.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/post-build.js && npm run action:build",
    "action:build": "node scripts/build-action.js",
    "build:watch": "tsc -p tsconfig.json --watch",
    "docs:build": "typedoc",
    "docs:check": "npm run docs:build && git diff --exit-code -- docs/site",
    "docs:watch": "typedoc --watch",
    "docs:serve": "node scripts/docs-serve.js",
    "docs:dev": "node scripts/docs-dev.js",
    "site:build": "npm run docs:build && node scripts/build-site.js",
    "site:check": "npm run site:build && node scripts/check-site.js && git diff --exit-code -- docs/site",
    "site:serve": "node scripts/site-serve.js",
    "site:dev": "npm run site:build && npm run site:serve",
    "site:deploy": "npm run site:check && firebase deploy --only hosting",
    "site:preview": "npm run site:check && firebase hosting:channel:deploy v2-preview",
    "clean": "node scripts/clean.js",
    "ci": "node --import tsx ./src/bin/beelzebub.ts --file ./beelzebub.ci.ts",
    "dev": "tsx src/bin/beelzebub.ts",
    "test": "vitest run",
    "test:package": "node scripts/test-package.js",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --exclude \"test/examples/**\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "validate-pkg": "publint && attw --pack .",
    "audit": "npm audit --audit-level=high && npm --prefix examples audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run coverage && npm run build && npm run test:package && npm run site:check && npm run validate-pkg && npm run audit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm run validate-pkg"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@types/node": "^24.13.3",
    "cli-table3": "^0.6.5",
    "cross-spawn": "^7.0.6",
    "picocolors": "^1.1.1",
    "stumpy": "^0.7.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.0.1"
}

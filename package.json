{
  "name": "beelzebub",
  "version": "2.0.0-dev",
  "description": "One Hell of a Task Master!",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "bz": "./dist/bin/beelzebub.js",
    "beelzebub": "./dist/bin/beelzebub.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jstty/beelzebub#readme",
  "keywords": [
    "node.js",
    "typescript",
    "javascript",
    "beelzebub",
    "beelzebub.io",
    "taskmaster",
    "task",
    "tasks",
    "tasker",
    "builder",
    "gulp",
    "streams"
  ],
  "author": {
    "name": "Joseph E. Sutton",
    "email": "joe@jstty.com",
    "url": "http://www.jstty.com"
  },
  "maintainers": [
    {
      "name": "jstty",
      "email": "joe@jstty.com"
    }
  ],
  "bugs": {
    "url": "https://github.com/jstty/beelzebub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jstty/beelzebub.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/post-build.js",
    "build:watch": "tsc -p tsconfig.json --watch",
    "docs:build": "typedoc",
    "docs:check": "typedoc --emit none",
    "docs:watch": "typedoc --watch",
    "docs:serve": "node scripts/docs-serve.js",
    "docs:dev": "node scripts/docs-dev.js",
    "clean": "node scripts/clean.js",
    "dev": "tsx src/bin/beelzebub.ts",
    "test": "vitest run",
    "test:package": "node scripts/test-package.js",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "validate-pkg": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "audit": "npm audit --audit-level=high && npm --prefix examples audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:package && npm run docs:check && npm run validate-pkg && npm run audit",
    "prepublishOnly": "npm run clean && npm run build && npm run validate-pkg"
  },
  "dependencies": {
    "@types/node": "^24.13.3",
    "cli-table3": "^0.6.5",
    "picocolors": "^1.1.1",
    "stumpy": "^0.7.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.21",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.0.1"
}
